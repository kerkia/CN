        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/tour/en/phone-ranking.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Die Rangliste"
    },
    {
      "src": "/assets/tour/en/phone-runner.webp",
      "sizes": "560x1212",
      "type": "image/webp",
