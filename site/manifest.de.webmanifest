{
  "id": "/",
  "name": "Ozimut — Orientierungslauf in Karten und Zahlen",
  "short_name": "Ozimut",
  "description": "Orientierungslauf in Karten und Zahlen: Ergebnisse, Startzeiten, GPS-Tracks, Training, Ranglisten.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f2ec",
  "theme_color": "#f4f2ec",
  "categories": [
    "sports"
  ],
  "icons": [
    {
      "src": "/assets/icon-192.png",
