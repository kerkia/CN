      "label": "Die Seite eines Läufers"
    },
    {
      "src": "/assets/tour/en/phone-race.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Ein Lauf"
    },
    {
      "src": "/assets/tour/en/ranking.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Die Rangliste"
    },
    {
      "src": "/assets/tour/en/runner-calc.webp",
