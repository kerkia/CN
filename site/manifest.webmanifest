  "file_handlers": [
    {
      "action": "/?recu=fichier",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.ant.fit": [
          ".fit"
        ],
        "application/vnd.garmin.tcx+xml": [
          ".tcx"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/gpx+xml",
            "application/vnd.ant.fit",
            "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kmz",
            "application/vnd.google-earth.kml+xml",
            "application/octet-stream",
            "application/xml",
            "text/xml",
            "image/*",
            "application/pdf",
            ".gpx",
            ".fit",
            ".tcx",
            ".kmz",
            ".kml"
          ]
        }
      ]
    }
  }
}
