{
  "id": "/",
  "name": "Ozimut — La course d'orientation, en cartes et en chiffres",
  "short_name": "Ozimut",
  "description": "La course d'orientation, en cartes et en chiffres : résultats, horaires de départ, traces GPS, entraînement, classements.",
  "lang": "fr",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
