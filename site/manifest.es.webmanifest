{
  "id": "/",
  "name": "Ozimut — La orientación, en mapas y cifras",
  "short_name": "Ozimut",
  "description": "La orientación, en mapas y cifras: resultados, horas de salida, tracks GPS, entrenamiento, clasificaciones.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f2ec",
  "theme_color": "#f4f2ec",
  "categories": [
    "sports"
  ],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Clasificación",
      "short_name": "Clasificación",
      "description": "La clasificación nacional",
      "url": "/#/classement",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Resultados",
      "short_name": "Resultados",
      "description": "Los resultados de las últimas carreras",
      "url": "/#/resultats",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendario",
      "short_name": "Calendario",
      "description": "Próximas carreras",
      "url": "/#/agenda",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Análisis individual",
      "short_name": "Análisis individual",
      "description": "Tu track GPS sobre el mapa",
      "url": "/#/analyse-solo",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/tour/en/phone-ranking.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "La clasificación"
    },
    {
      "src": "/assets/tour/en/phone-runner.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "La página de un corredor"
    },
    {
      "src": "/assets/tour/en/phone-race.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Una carrera"
    },
    {
      "src": "/assets/tour/en/ranking.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "La clasificación"
    },
    {
      "src": "/assets/tour/en/runner-calc.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Cómo se calcula el índice"
    },
    {
      "src": "/assets/tour/en/past.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Competiciones pasadas y sus resultados"
    }
  ],
  "file_handlers": [
    {
      "action": "/?recu=fichier",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.ant.fit": [
          ".fit"
        ],
        "application/vnd.garmin.tcx+xml": [
          ".tcx"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/gpx+xml",
            "application/vnd.ant.fit",
            "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kmz",
            "application/vnd.google-earth.kml+xml",
            "application/octet-stream",
            "application/xml",
            "text/xml",
            "image/*",
            "application/pdf",
            ".gpx",
            ".fit",
            ".tcx",
            ".kmz",
            ".kml"
          ]
        }
      ]
    }
  }
}
