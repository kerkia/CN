{
  "id": "/",
  "name": "Ozimut — Orienteering, in maps and numbers",
  "short_name": "Ozimut",
  "description": "French orienteering national ranking: rankings, results, start times, analyses.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f2ec",
  "theme_color": "#f4f2ec",
  "categories": [
    "sports"
  ],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Ranking",
      "short_name": "Ranking",
      "description": "The national ranking",
      "url": "/#/classement",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Results",
      "short_name": "Results",
      "description": "The latest races' results",
      "url": "/#/resultats",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Coming races",
      "url": "/#/agenda",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Solo analysis",
      "short_name": "Solo analysis",
      "description": "Your GPS trace on the map",
      "url": "/#/analyse-solo",
      "icons": [
        {
          "src": "/assets/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "/assets/tour/en/phone-ranking.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "The ranking"
    },
    {
      "src": "/assets/tour/en/phone-runner.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "A runner's page"
    },
    {
      "src": "/assets/tour/en/phone-race.webp",
      "sizes": "560x1212",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "A race"
    },
    {
      "src": "/assets/tour/en/ranking.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The ranking"
    },
    {
      "src": "/assets/tour/en/runner-calc.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "How the index is computed"
    },
    {
      "src": "/assets/tour/en/results.webp",
      "sizes": "1400x875",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "The organisers' results"
    }
  ],
  "file_handlers": [
    {
      "action": "/?recu=fichier",
      "accept": {
        "application/gpx+xml": [
          ".gpx"
        ],
        "application/vnd.ant.fit": [
          ".fit"
        ],
        "application/vnd.garmin.tcx+xml": [
          ".tcx"
        ],
        "application/vnd.google-earth.kmz": [
          ".kmz"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/gpx+xml",
            "application/vnd.ant.fit",
            "application/vnd.garmin.tcx+xml",
            "application/vnd.google-earth.kmz",
            "application/vnd.google-earth.kml+xml",
            "application/octet-stream",
            "application/xml",
            "text/xml",
            "image/*",
            "application/pdf",
            ".gpx",
            ".fit",
            ".tcx",
            ".kmz",
            ".kml"
          ]
        }
      ]
    }
  }
}
