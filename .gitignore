# Code only: the results, the runners and everything derived from them stay out
# of this (public) repository. Between automated runs they live in Cloudflare R2.

# database, HTTP cache and runner state
*.sqlite3
*.sqlite3-*
*.update.lock
cache/
.state/

# generated site data and the login index
site/data/
site/auth/
site/assets/build.txt

# reports, exports, local data files
exports/
legacy_listings/
*.csv

# Python / Node / editors
__pycache__/
*.pyc
.venv/
node_modules/
.wrangler/
.vscode/
.idea/
.DS_Store
Thumbs.db

# local assistant settings
.claude/
.dev.vars

# the white paper build (docs/whitepaper/build.py): the PDF is published under site/assets
docs/whitepaper/methode-top.pdf
docs/whitepaper/methode-top.en.pdf
docs/whitepaper/*.aux
docs/whitepaper/*.log
docs/whitepaper/*.out
docs/whitepaper/*.toc
